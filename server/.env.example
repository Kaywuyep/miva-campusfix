# Copy this file to .env and fill in your own values
NODE_ENV=development
PORT=5002

# Local MongoDB:  mongodb://127.0.0.1:27017/codespireFix
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codespireFix
MONGO_URI=mongodb://127.0.0.1:27017/codespireFix

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Where the React app runs (for CORS and Socket.IO)
CLIENT_URL=http://localhost:5173

